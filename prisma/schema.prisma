// Prisma schema for Aspen Vision — internal management system
// Design notes (assumptions, revisit if wrong):
// - Postgres (hosted on Supabase), reached through Supavisor's transaction
//   pooler (DATABASE_URL) for app queries and a direct connection
//   (DIRECT_URL) for migrations — the standard pairing for a serverless
//   Vercel deployment, since migrations need a session-scoped connection the
//   pooler doesn't provide.
// - `Product.stock` is a cached counter, not the source of truth. The source
//   of truth is the append-only `InventoryMovement` ledger. Every write that
//   changes stock creates a movement row and updates the cached counter in
//   the same DB transaction, so the two can never drift.
// - Money is stored in integer CLP (Chilean pesos, no decimals) to avoid
//   floating point rounding issues. Adjust if the business uses a currency
//   with subunits.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // Full access: catalog, users, all reports, inventory adjustments
  VENDEDOR // Can register sales, view inventory (read-only), view own sales
  PREPARADOR // Confirms pending sales (inventory prep/fulfillment), manages inventory entries
  CONTADORA // Accounting-only: sees exclusively Cobranzas and Información Cobranzas
}

enum MovementType {
  ENTRADA // Stock received into inventory (purchase/restock)
  VENTA // Stock leaving because of a confirmed sale
  EMBAJADOR // Stock leaving as a gifted delivery to an ambassador
  GARANTIA // Stock leaving to resolve a warranty claim
  AJUSTE // Manual correction (loss, damage, recount, etc.)
}

enum SaleFulfillmentStatus {
  PENDIENTE_CONFIRMACION // Sale happened commercially, stock NOT yet discounted
  CONFIRMADA // Preparador confirmed; stock has been discounted
}

enum WarrantyStatus {
  PENDIENTE
  RESUELTA
  RECHAZADA
}

enum NotificationType {
  VENTA_PENDIENTE
  STOCK_BAJO
  STOCK_AGOTADO
  GENERAL
}

enum CollectionPaymentKind {
  ABONO // Real money received; counts toward saldo/estado
  ACUERDO // Just a promise to pay by a given date; purely informational
  NOTA_CREDITO // Returned merchandise; reduces the document's effective total and saldo, same as an ABONO but isn't money received
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VENDEDOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales                Sale[]               @relation("SaleSeller")
  confirmedSales       Sale[]               @relation("SaleConfirmedBy")
  inventoryMovements   InventoryMovement[]  @relation("MovementUser")
  ambassadorDeliveries AmbassadorDelivery[] @relation("DeliveryUser")
  warranties           Warranty[]           @relation("WarrantyResponsible")
  notifications        Notification[]
  collectionPayments   CollectionPayment[]
  assignedCustomers    Customer[]           @relation("CustomerAssignedSeller")
  customerActivities   CustomerActivity[]   @relation("ActivityCreatedBy")

  @@index([role])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id         String   @id @default(cuid())
  name       String // Nombre comercial del producto, independiente de marca/modelo
  barcode    String   @unique
  brand      String
  model      String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  shape      String? // Forma (e.g. Cuadrado, Redondo, Aviador)
  color      String?
  material   String?
  notes      String?
  images     Json     @default("[]") // ordered array of image URLs; images[0] is the cover photo
  stock      Int      @default(0) // cached — derived from InventoryMovement ledger
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  movements       InventoryMovement[]
  saleItems       SaleItem[]
  ambassadorItems AmbassadorDeliveryItem[]
  warranties      Warranty[]

  @@index([categoryId])
  @@index([brand])
  @@index([active])
}

// Append-only ledger. Never update or delete rows — corrections are new
// AJUSTE rows. `quantity` is signed: positive = stock in, negative = stock out.
model InventoryMovement {
  id                   String              @id @default(cuid())
  productId            String
  product              Product             @relation(fields: [productId], references: [id])
  type                 MovementType
  quantity             Int
  reason               String?
  // Free-form human-readable reference shown in the ledger UI, e.g. "Venta #A-102"
  reference            String?
  // Polymorphic link back to the originating record, for click-through navigation
  saleId               String?
  sale                 Sale?               @relation(fields: [saleId], references: [id])
  ambassadorDeliveryId String?
  ambassadorDelivery   AmbassadorDelivery? @relation(fields: [ambassadorDeliveryId], references: [id])
  warrantyId           String?
  warranty             Warranty?           @relation(fields: [warrantyId], references: [id])
  userId               String
  user                 User                @relation("MovementUser", fields: [userId], references: [id])
  createdAt            DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([type])
}

model Sale {
  id                   String                @id @default(cuid())
  code                 String                @unique // human-friendly, e.g. V-000123
  date                 DateTime              @default(now())
  sellerId             String
  seller               User                  @relation("SaleSeller", fields: [sellerId], references: [id])
  requiresConfirmation Boolean               @default(true)
  status               SaleFulfillmentStatus @default(CONFIRMADA)
  inventoryApplied     Boolean               @default(false) // guard against double-discount
  confirmedById        String?
  confirmedBy          User?                 @relation("SaleConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt          DateTime?
  customerId           String?
  customer             Customer?             @relation(fields: [customerId], references: [id])
  paymentMethod        String?
  notes                String?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  items         SaleItem[]
  movements     InventoryMovement[]
  notifications Notification[]

  @@index([status])
  @@index([sellerId])
  @@index([date])
  @@index([customerId])
}

// A buyer (persona o empresa) a quien se le emite la venta. Se identifica por
// RUT para poder autocompletar razón social en ventas futuras al mismo cliente.
// Also doubles as the CRM record for the sales team's client-relationship
// tracking (Clientes/Hoy) — city/contact/commercial-terms fields below are
// only used there, not by the Ventas flow.
model Customer {
  id           String   @id @default(cuid())
  name         String
  rut          String   @unique
  businessName String? // Razón social, para clientes con facturación a empresa
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  city             String?
  contactName      String? // Persona de contacto, si difiere del nombre del cliente
  phone            String?
  email            String?
  birthdayMonth    Int? // 1-12 — dos enteros en vez de DateTime para poder
  birthdayDay      Int? // consultar "cumpleaños hoy" sin importar el año
  customerSince    DateTime? // Fecha de ingreso real (puede ser anterior al alta en el sistema) — calendario puro, medianoche UTC
  paymentTermsDays Int? // Condiciones comerciales: días de plazo de pago
  discountPercent  Float?    @default(0) // Condiciones comerciales: % de descuento acordado

  assignedSellerId String?
  assignedSeller   User?   @relation("CustomerAssignedSeller", fields: [assignedSellerId], references: [id])

  sales      Sale[]
  activities CustomerActivity[]

  @@index([assignedSellerId])
  @@index([birthdayMonth, birthdayDay])
}

enum CustomerActivityType {
  VISITA
  LLAMADA
  WHATSAPP
}

enum CustomerActivityStatus {
  PENDIENTE
  COMPLETADA
}

// Seguimiento comercial: a chronological log of visits/calls/WhatsApp
// contacts with a customer, each optionally carrying a next action + due
// date. This is a real ledger (source of truth), unlike Estado/Deuda which
// stay computed at read time from Sale/Collection — see src/lib/customers.ts.
model CustomerActivity {
  id             String                 @id @default(cuid())
  customerId     String
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date           DateTime // Fecha del contacto — calendario puro, medianoche UTC
  type           CustomerActivityType
  summary        String
  nextAction     String?
  nextActionDate DateTime? // Calendario puro, medianoche UTC — impulsa "Hoy" y "Próximo contacto"
  status         CustomerActivityStatus @default(PENDIENTE)
  createdById    String
  createdBy      User                   @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime               @default(now())

  @@index([customerId, date])
  @@index([status, nextActionDate])
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  position        Int     @default(0) // display order within the sale, user-sortable
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Int // precio unitario de lista (sin IVA, sin descuento)
  discountPercent Float   @default(0) // % de descuento sobre la línea (0-100)
  discountAmount  Int     @default(0) // monto descontado, en CLP: quantity*unitPrice*discountPercent/100
  taxAmount       Int     @default(0) // IVA de la línea (19% del subtotal neto, ya con descuento aplicado)
  subtotal        Int // neto tras descuento: quantity*unitPrice - discountAmount
  total           Int     @default(0) // subtotal + taxAmount
  notes           String?

  @@index([saleId])
  @@index([productId])
}

model Ambassador {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  instagram String?
  tiktok    String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries AmbassadorDelivery[]
}

model AmbassadorDelivery {
  id            String     @id @default(cuid())
  code          String     @unique // e.g. E-000045
  ambassadorId  String
  ambassador    Ambassador @relation(fields: [ambassadorId], references: [id])
  date          DateTime   @default(now())
  notes         String?
  deliveredById String
  deliveredBy   User       @relation("DeliveryUser", fields: [deliveredById], references: [id])
  createdAt     DateTime   @default(now())

  items     AmbassadorDeliveryItem[]
  movements InventoryMovement[]

  @@index([ambassadorId])
  @@index([date])
}

model AmbassadorDeliveryItem {
  id         String             @id @default(cuid())
  deliveryId String
  delivery   AmbassadorDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId  String
  product    Product            @relation(fields: [productId], references: [id])
  quantity   Int

  @@index([deliveryId])
  @@index([productId])
}

model Warranty {
  id               String         @id @default(cuid())
  code             String         @unique // e.g. G-000012
  date             DateTime       @default(now())
  customerName     String
  customerContact  String?
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int            @default(1)
  reason           String
  notes            String?
  status           WarrantyStatus @default(PENDIENTE)
  inventoryApplied Boolean        @default(false)
  responsibleId    String?
  responsible      User?          @relation("WarrantyResponsible", fields: [responsibleId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  movements InventoryMovement[]

  @@index([status])
  @@index([date])
}

// Cobranzas: standalone accounts-receivable tracker. Deliberately independent
// from Sale/Customer — it mirrors the finance team's own spreadsheet (fed by
// SII exports), not the POS sales flow, so it keeps its own client identity
// fields instead of joining to Customer.
model Collection {
  id           String   @id @default(cuid())
  city         String
  clientRut    String
  businessName String
  folio        String
  documentDate DateTime
  netAmount    Int
  taxAmount    Int
  totalAmount  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments CollectionPayment[]

  @@index([documentDate])
  @@index([clientRut])
  @@index([folio])
}

// totalAbonado/saldo/estado are derived from this ledger at read time, never
// stored — same append-only-source-of-truth idea as InventoryMovement.
// ACUERDO rows are purely informational (a client's promise to pay by a
// given date) and are excluded from that saldo math entirely — only ABONO
// rows count as real money received. NOTA_CREDITO rows aren't money either,
// but they do reduce the document's effective total (and therefore saldo),
// since returned merchandise lowers what the client actually owes.
model CollectionPayment {
  id           String                @id @default(cuid())
  collectionId String
  collection   Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  kind         CollectionPaymentKind @default(ABONO)
  date         DateTime
  amount       Int
  method       String
  // Only populated when method is "Cheque": an ordered breakdown like
  // [{ label: "Cheque 1", amount: 10000, numero: "123456", banco: "Banco Estado" }, ...].
  // `amount` above is always the source of truth for the payment total
  // (recomputed as the sum of these when present), this is just the
  // itemized detail for display.
  checks       Json?
  // Only populated when kind is NOTA_CREDITO: the returned models, like
  // [{ modelo: "RB2140", cantidad: 2, valorUnitario: 45000 }, ...].
  // `amount` above is always the sum of cantidad*valorUnitario over these.
  creditItems  Json?
  note         String?
  createdById  String
  createdBy    User                  @relation(fields: [createdById], references: [id])
  createdAt    DateTime              @default(now())

  // ACUERDO-only: the client actually paid, so this promise was fulfilled.
  // Checking it in the UI atomically creates the real ABONO row below and
  // links back here, instead of asking someone to re-enter the same data —
  // `fulfilledBy` is that ABONO's own row, found via its `fulfillsAgreementId`.
  paid                Boolean            @default(false)
  fulfillsAgreementId String?            @unique
  fulfillsAgreement   CollectionPayment? @relation("AgreementFulfillment", fields: [fulfillsAgreementId], references: [id])
  fulfilledBy         CollectionPayment? @relation("AgreementFulfillment")

  @@index([collectionId])
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  message    String
  link       String?
  // null userId = broadcast to every ADMIN/PREPARADOR (role-targeted, see targetRole)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])
  targetRole Role?
  saleId     String?
  sale       Sale?            @relation(fields: [saleId], references: [id])
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@index([targetRole, read])
}
